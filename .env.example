# Copy to .env and fill in. Never commit .env.

# ── Discord (Developer Portal → your application) ──────────────────────────
# Bot → Reset Token
DISCORD_TOKEN=
# General Information → Application ID
DISCORD_CLIENT_ID=
# Right-click your server → Copy Server ID (enable Developer Mode in Discord settings first)
GUILD_ID=

# ── Dashboard ──────────────────────────────────────────────────────────────
# Set to false to run the bot without the web dashboard (then the two secrets below are optional).
DASHBOARD_ENABLED=true
# OAuth2 → Client Secret
DISCORD_CLIENT_SECRET=
# Random string, at least 32 characters: openssl rand -hex 32
SESSION_SECRET=
# Public URL people use to reach the dashboard (no trailing slash). The OAuth redirect is
# ${PUBLIC_BASE_URL}/api/auth/callback; add that exact URL under OAuth2 → Redirects.
# Local development with the Vite dev server (pnpm dev:web): use http://localhost:5173.
PUBLIC_BASE_URL=http://localhost:3000
# Session lifetime in hours (default 7 days)
SESSION_TTL_HOURS=168
# Defaults to true when PUBLIC_BASE_URL starts with https://
# COOKIE_SECURE=true
# Behind Nginx Proxy Manager / Cloudflare: "true", a hop count like "1", or comma-separated proxy IPs/CIDRs.
TRUST_PROXY=false

# ── Server ─────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=3000
# Local development path. docker-compose overrides this to /data/bernard.db.
DATABASE_PATH=./data/bernard.db

# ── Logging ────────────────────────────────────────────────────────────────
# fatal | error | warn | info | debug | trace
LOG_LEVEL=info
# Human-readable logs (development). Leave false in production for JSON logs.
LOG_PRETTY=false
